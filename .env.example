# ==========================================
# Environment Variables - Happy Paws
# ==========================================
# Copia este archivo a .env o configura estas variables en Render.
# Nunca subas valores reales de passwords o service_role keys.

# Base de datos PostgreSQL / Supabase
DB_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=postgres.tu_project_ref
DB_PASSWORD=tu_password_de_supabase

# Puerto del servidor
PORT=8080

# JPA / inicializacion SQL
JPA_DDL_AUTO=update
SQL_INIT_MODE=never
JPA_SHOW_SQL=false

# Supabase Storage
SUPABASE_URL=https://tu_project_ref.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key
SUPABASE_STORAGE_BUCKET=historial-clinico

# Usuario administrador inicial
ADMIN_INITIAL_EMAIL=admin@happypaws.com
ADMIN_INITIAL_PASSWORD=cambia_este_password

# Solo para pruebas locales si quieres usuarios demo adicionales.
SEED_DEMO_USERS=false
DEMO_USERS_PASSWORD=
