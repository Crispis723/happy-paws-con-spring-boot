# ==========================================
# Environment Variables - Happy Paws
# ==========================================
# Copia este archivo a .env en tu Replit
# y completa con tus valores reales

# Base de Datos MySQL
DB_HOST=your-db-host.mysql.pythonanywhere.com
DB_PORT=3306
DB_NAME=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Puerto del servidor
SERVER_PORT=8080

# Entorno
ENVIRONMENT=production
